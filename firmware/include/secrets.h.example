#pragma once

/**
 * Optional factory defaults only.
 *
 * Product flow for your friend (NO code / terminal):
 *   1. Power on macropad → screen says connect phone to Wi‑Fi "Macropad-XXXX"
 *   2. Phone opens setup page → enter home Wi‑Fi (+ App URL if needed)
 *   3. Device shows a 6-char code → friend enters it on the website /app/devices
 *
 * Wi‑Fi is saved in NVS flash. secrets.h is ONLY for developers / factory flash
 * of a default App URL (FACTORY_API_BASE_URL / API_BASE_URL).
 *
 * For a real product: host the Next.js app (Vercel etc.) and set:
 *   #define FACTORY_API_BASE_URL "https://your-macropad.vercel.app"
 * then friends never touch API URL either.
 */

#ifndef FACTORY_API_BASE_URL
#define FACTORY_API_BASE_URL "https://macropad-tawny.vercel.app"
#endif

/* Optional: seed Wi‑Fi for lab devices (skip SoftAP). Leave YOUR_WIFI to skip. */
#ifndef WIFI_SSID
#define WIFI_SSID "YOUR_WIFI"
#endif
#ifndef WIFI_PASSWORD
#define WIFI_PASSWORD "YOUR_PASSWORD"
#endif

/* Back-compat alias used only if FACTORY_API_BASE_URL unset above */
#ifndef API_BASE_URL
#define API_BASE_URL FACTORY_API_BASE_URL
#endif
